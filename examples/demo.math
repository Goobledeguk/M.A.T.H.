# M.A.T.H. demo script -- run with:  python -m mathcalc examples/demo.math
:/ 16                       # square root            -> 4.0
::/ 27                      # cube root              -> 3.0
5 :/!                       # factorial              -> 120
7 ://!                      # double factorial       -> 105
7 /// 2                     # ceiling division       -> 4
7 //: 3                     # modulo                 -> 1
3 :/+ 4                     # hypotenuse             -> 5.0
2 ** 3                      # exponentiation         -> 8

val = ::/ 27 + (1 /: 3)     # slide 10 example
a = 5; b = 12
a :/+ b                     # -> 13.0

(1 /: 3) + (1 /: 6)         # exact fractions        -> 1/2
1 .. 5                      # range generator
(1 .. 5) ** 2               # element-wise           -> [1, 4, 9, 16, 25]
[1, 5, 3] >= 3              # array comparison       -> [false, true, true]
